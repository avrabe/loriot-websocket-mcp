{
  "name": "loriot-web-styles",
  "version": "1.0.0",
  "description": "Tailwind CSS build for LoRaWAN sensor dashboard",
  "scripts": {
    "css:build": "tailwindcss -c ./style/tailwind.config.js -i ./style/input.css -o ./assets/css/output.css",
    "css:watch": "tailwindcss -c ./style/tailwind.config.js -i ./style/input.css -o ./assets/css/output.css --watch",
    "css:prod": "tailwindcss -c ./style/tailwind.config.js -i ./style/input.css -o ./assets/css/output.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "daisyui": "^4.12.0"
  }
}
